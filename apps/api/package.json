{
  "name": "@fbe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.spec.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fbe/access-policy": "workspace:*",
    "@fbe/config": "workspace:*",
    "@fbe/database": "workspace:*",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "better-auth": "1.7.27",
    "cors": "2.8.5",
    "express": "5.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@fbe/worker": "workspace:*",
    "@better-auth/utils": "0.5.1",
    "@nestjs/testing": "12.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
