# EXCLUSIVAMENTE LOCAL Y SINTETICO. No reutilizar estos valores fuera de desarrollo.
APP_ENV=development
APP_NAME="FBE Synthetic Local"
API_PORT=3001
API_HOST_PORT=3001
WEB_HOST_PORT=3000
POSTGRES_HOST_PORT=55432
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# La clave debe reemplazarse con `pnpm env:init`; este marcador no arranca la API.
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3001
AUTH_RESET_TOKEN_TTL_SECONDS=900

# Base aislada para este repositorio. La contraseña es solo un marcador local.
POSTGRES_DB=fbe_synthetic
POSTGRES_USER=fbe_local
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://fbe_local:replace-with-a-random-local-password@localhost:55432/fbe_synthetic?schema=public

# Los fixtures solo se permiten con ambos controles explícitos.
ALLOW_SYNTHETIC_INVITATIONS=false
ALLOW_SYNTHETIC_SEED=false
SYNTHETIC_DATA_ONLY=true
LOG_LEVEL=info
